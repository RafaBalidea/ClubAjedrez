@inherits LayoutComponentBase

@* Proveedores de MudBlazor: tema, popovers (menús, selects, date pickers), diálogos y avisos. *@
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* data-interactive: "true" cuando la página ya responde (tras el prerenderizado); lo esperan los tests E2E. *@
<MudLayout data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => menuAbierto = !menuAbierto" aria-label="Menú" />
        <MudText Typo="Typo.h6" Class="ml-2">Club Xadrez Algalia</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="menuAbierto" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool menuAbierto = true;
}
